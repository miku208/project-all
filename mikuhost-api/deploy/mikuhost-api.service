[Unit]
Description=MikuHost-Api REST API
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/mikuhost-api
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8686
ExecStart=/usr/bin/node /var/www/mikuhost-api/dist/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

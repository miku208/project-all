// ================================================================
// MTD - Miku TikTok Downloader
// app.js - Frontend Application (FIXED - No Null Errors)
// ================================================================

// ================================================================
// 1. API CLIENT
// ================================================================

class ApiClient {
    constructor() {
        this.baseUrl = window.location.origin;
    }
    
    async download(url) {
        const response = await fetch(`${this.baseUrl}/api/download`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ url })
        });
        
        if (!response.ok) {
            const error = await response.json();
            throw new Error(error.error || 'Download failed');
        }
        
        return response.json();
    }
    
    async getStatus() {
        const response = await fetch(`${this.baseUrl}/api/status`);
        return response.json();
    }
    
    async getStats() {
        const response = await fetch(`${this.baseUrl}/api/stats`);
        return response.json();
    }
    
    async healthCheck() {
        const response = await fetch(`${this.baseUrl}/api/health`);
        return response.json();
    }

    // Bangun URL endpoint backend yang mem-proxy file media sebagai
    // attachment (Content-Disposition) — SATU-SATUNYA sumber untuk
    // semua download, tidak pernah fetch/redirect langsung ke CDN TikTok.
    getProxyDownloadUrl(mediaUrl, filename) {
        const params = new URLSearchParams({ url: mediaUrl, filename });
        return `${this.baseUrl}/api/proxy?${params.toString()}`;
    }
}

// ================================================================
// 2. UI CONTROLLER
// ================================================================

class App {
    constructor() {
        this.api = new ApiClient();
        this.currentResult = null;
        this.carouselIndex = 0;
        this.carouselImages = [];
        this.currentImageUrl = '';   // URL gambar slide aktif, dipakai oleh downloadImageBtn
        this.statsInterval = null;
        this.statusInterval = null;
        this.whatsappChannelUrl = 'https://whatsapp.com/channel/0029Vb68NhFGU3BTg1VP2w2V';
        
        this.init();
    }
    
    init() {
        // DOM Elements - dengan null check
        this.urlInput = document.getElementById('urlInput');
        this.downloadBtn = document.getElementById('downloadBtn');
        this.resultSection = document.getElementById('resultSection');
        this.previewContainer = document.getElementById('previewContainer');
        this.previewImage = document.getElementById('previewImage');
        this.previewVideo = document.getElementById('previewVideo');
        this.previewSkeleton = document.getElementById('previewSkeleton');
        this.playOverlay = document.getElementById('playOverlay');
        this.carouselContainer = document.getElementById('carouselContainer');
        this.carouselSlides = document.getElementById('carouselSlides');
        this.carouselPrev = document.getElementById('carouselPrev');
        this.carouselNext = document.getElementById('carouselNext');
        this.carouselCounter = document.getElementById('carouselCounter');
        this.carouselDots = document.getElementById('carouselDots');
        this.resultContent = document.getElementById('resultContent');
        this.titleSkeleton = document.getElementById('titleSkeleton');
        this.metaSkeleton = document.getElementById('metaSkeleton');
        
        // Result info
        this.resultTitle = document.getElementById('resultTitle');
        this.resultDuration = document.getElementById('resultDuration');
        this.resultDate = document.getElementById('resultDate');
        this.resultRegion = document.getElementById('resultRegion');
        this.resultViews = document.getElementById('resultViews');
        this.resultLikes = document.getElementById('resultLikes');
        this.resultComments = document.getElementById('resultComments');
        this.resultShares = document.getElementById('resultShares');
        this.resultAvatar = document.getElementById('resultAvatar');
        this.resultAuthorName = document.getElementById('resultAuthorName');
        this.resultAuthorUsername = document.getElementById('resultAuthorUsername');
        this.musicContainer = document.getElementById('musicContainer');
        this.musicTitle = document.getElementById('musicTitle');
        this.musicAuthor = document.getElementById('musicAuthor');
        
        // Buttons
        this.downloadMp4Btn = document.getElementById('downloadMp4Btn');
        this.downloadHdBtn = document.getElementById('downloadHdBtn');
        this.downloadMp3Btn = document.getElementById('downloadMp3Btn');
        this.copyCaptionBtn = document.getElementById('copyCaptionBtn');
        this.copyLinkBtn = document.getElementById('copyLinkBtn');
        this.downloadImageBtn = document.getElementById('downloadImageBtn');
        this.downloadMp3Btn2 = document.getElementById('downloadMp3Btn2');
        
        // Navigation
        this.navbar = document.getElementById('navbar');
        this.navLinks = document.getElementById('navLinks');
        this.hamburger = document.getElementById('hamburger');
        this.homeLink = document.getElementById('homeLink');
        this.homeLink2 = document.getElementById('homeLink2');
        this.statusLink = document.getElementById('statusLink');
        this.dashboardLink = document.getElementById('dashboardLink');
        this.whatsappLink = document.getElementById('whatsappLink');
        this.whatsappChannelBtn = document.getElementById('whatsappChannelBtn');
        
        // Pages
        this.heroSection = document.getElementById('heroSection');
        this.statsSection = document.getElementById('statsSection');
        this.statusPage = document.getElementById('statusPage');
        this.dashboardPage = document.getElementById('dashboardPage');
        this.statsGrid = document.getElementById('statsGrid');
        this.statusGrid = document.getElementById('statusGrid');
        this.dashboardStats = document.getElementById('dashboardStats');
        this.chartBars = document.getElementById('chartBars');
        this.chartLabels = document.getElementById('chartLabels');
        this.dashDownloads = document.getElementById('dashDownloads');
        this.dashVisitors = document.getElementById('dashVisitors');
        this.dashRequests = document.getElementById('dashRequests');
        this.dashResponse = document.getElementById('dashResponse');
        
        // Events - dengan null check
        if (this.downloadBtn) {
            this.downloadBtn.addEventListener('click', () => this.handleDownload());
        }
        
        if (this.urlInput) {
            this.urlInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') this.handleDownload();
            });
        }
        
        if (this.carouselPrev) {
            this.carouselPrev.addEventListener('click', () => this.carouselPrevImage());
        }
        
        if (this.carouselNext) {
            this.carouselNext.addEventListener('click', () => this.carouselNextImage());
        }
        
        if (this.downloadMp4Btn) {
            this.downloadMp4Btn.addEventListener('click', () => this.downloadVideo('mp4'));
        }
        
        if (this.downloadHdBtn) {
            this.downloadHdBtn.addEventListener('click', () => this.downloadVideo('hd'));
        }
        
        if (this.downloadMp3Btn) {
            this.downloadMp3Btn.addEventListener('click', () => this.downloadAudio());
        }
        
        if (this.downloadMp3Btn2) {
            this.downloadMp3Btn2.addEventListener('click', () => this.downloadAudio());
        }
        
        if (this.copyCaptionBtn) {
            this.copyCaptionBtn.addEventListener('click', () => this.copyCaption());
        }
        
        if (this.copyLinkBtn) {
            this.copyLinkBtn.addEventListener('click', () => this.copyLink());
        }
        
        // Image button — SATU event listener, SATU kali registrasi.
        // this.currentImageUrl di-update setiap kali slide berubah di updateCarousel().
        if (this.downloadImageBtn) {
            this.downloadImageBtn.addEventListener('click', () => {
                const url = this.currentImageUrl;
                if (!url) {
                    console.warn('downloadImageBtn: currentImageUrl kosong');
                    this.showToast('❌ Gambar belum tersedia', 'error');
                    return;
                }
                const filename = `mtd-image-${this.carouselIndex + 1}.jpg`;
                this.downloadFile(url, filename);
            });
        } else {
            console.warn('downloadImageBtn not found');
        }
        
        // Navigation
        if (this.hamburger) {
            this.hamburger.addEventListener('click', () => {
                if (this.navLinks) {
                    this.navLinks.classList.toggle('open');
                }
            });
        }
        
        if (this.homeLink) {
            this.homeLink.addEventListener('click', (e) => {
                e.preventDefault();
                this.showPage('home');
            });
        }
        
        if (this.homeLink2) {
            this.homeLink2.addEventListener('click', (e) => {
                e.preventDefault();
                this.showPage('home');
            });
        }
        
        if (this.statusLink) {
            this.statusLink.addEventListener('click', (e) => {
                e.preventDefault();
                this.showPage('status');
                this.loadStatus();
            });
        }
        
        if (this.dashboardLink) {
            this.dashboardLink.addEventListener('click', (e) => {
                e.preventDefault();
                this.showPage('dashboard');
                this.loadDashboard();
            });
        }
        
        // WhatsApp Channel Links
        if (this.whatsappLink) {
            this.whatsappLink.addEventListener('click', (e) => {
                e.preventDefault();
                this.openWhatsApp();
            });
        }
        
        if (this.whatsappChannelBtn) {
            this.whatsappChannelBtn.addEventListener('click', (e) => {
                e.preventDefault();
                this.openWhatsApp();
            });
        }
        
        // Scroll navbar effect
        window.addEventListener('scroll', () => {
            if (this.navbar) {
                this.navbar.classList.toggle('scrolled', window.scrollY > 20);
            }
        });
        
        // Load stats
        this.loadStats();
        this.statsInterval = setInterval(() => this.loadStats(), 30000);
        
        // Close mobile nav on link click
        if (this.navLinks) {
            document.querySelectorAll('.nav-links a').forEach(link => {
                link.addEventListener('click', () => {
                    if (this.navLinks) {
                        this.navLinks.classList.remove('open');
                    }
                });
            });
        }
        
        console.log('🚀 MTD App initialized');
        console.log('📱 WhatsApp Channel:', this.whatsappChannelUrl);
    }
    
    // ============================================================
    // WHATSAPP HANDLER
    // ============================================================
    
    openWhatsApp() {
        try {
            const channelWindow = window.open(this.whatsappChannelUrl, '_blank');
            
            if (!channelWindow || channelWindow.closed || typeof channelWindow.closed === 'undefined') {
                this.showToast('⚠️ Mohon izinkan popup untuk membuka WhatsApp Channel', 'warning');
                if (confirm('Gagal membuka WhatsApp Channel. Ingin coba lagi?')) {
                    window.open(this.whatsappChannelUrl, '_blank');
                }
            }
        } catch (error) {
            console.error('Error opening WhatsApp:', error);
            this.showToast('❌ Gagal membuka WhatsApp Channel', 'error');
            window.open(this.whatsappChannelUrl, '_blank');
        }
    }
    
    // ============================================================
    // DOWNLOAD HANDLER
    // ============================================================
    
    async handleDownload() {
        if (!this.urlInput) return;
        const url = this.urlInput.value.trim();
        
        if (!url) {
            this.showToast('Silakan masukkan URL TikTok', 'warning');
            return;
        }
        
        if (!url.includes('tiktok.com')) {
            this.showToast('URL TikTok tidak valid', 'error');
            return;
        }
        
        if (this.downloadBtn) {
            this.downloadBtn.disabled = true;
            this.downloadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Memproses...';
        }
        
        // Show skeleton
        if (this.resultSection) {
            this.resultSection.classList.add('active');
        }
        
        if (this.resultContent) {
            this.resultContent.style.display = 'none';
        }
        
        // Tampilkan previewContainer (skeleton), sembunyikan carousel
        if (this.previewContainer) this.previewContainer.style.display = '';
        if (this.previewSkeleton) this.previewSkeleton.style.display = 'block';
        if (this.previewImage) this.previewImage.style.display = 'none';
        if (this.previewVideo) this.previewVideo.style.display = 'none';
        if (this.playOverlay) this.playOverlay.style.display = 'none';
        if (this.carouselContainer) this.carouselContainer.style.display = 'none';
        
        if (this.titleSkeleton) {
            this.titleSkeleton.style.display = 'block';
        }
        
        if (this.metaSkeleton) {
            this.metaSkeleton.style.display = 'block';
        }
        
        try {
            const result = await this.api.download(url);
            this.currentResult = result;
            this.renderResult(result);
            this.showToast(`✅ Download berhasil via ${result.provider}`, 'success');
        } catch (error) {
            console.error('Download error:', error);
            this.showToast(error.message || '❌ Gagal mendownload. Silakan coba lagi.', 'error');
            if (this.resultSection) {
                this.resultSection.classList.remove('active');
            }
        }
        
        if (this.downloadBtn) {
            this.downloadBtn.disabled = false;
            this.downloadBtn.innerHTML = '<i class="fas fa-download"></i> Download';
        }
    }
    
    // ============================================================
    // RENDER RESULT
    // ============================================================
    
    renderResult(result) {
        const data = result.data;
        
        // Hide skeletons
        if (this.previewSkeleton) this.previewSkeleton.style.display = 'none';
        if (this.titleSkeleton) this.titleSkeleton.style.display = 'none';
        if (this.metaSkeleton) this.metaSkeleton.style.display = 'none';
        if (this.resultContent) this.resultContent.style.display = 'block';
        if (this.carouselContainer) this.carouselContainer.style.display = 'none';
        
        // Reset tombol video/audio (downloadImageBtn TIDAK di-reset di sini —
        // visibilitasnya dikendalikan oleh carouselContainer parent-nya)
        if (this.downloadMp4Btn) this.downloadMp4Btn.style.display = 'none';
        if (this.downloadHdBtn) this.downloadHdBtn.style.display = 'none';
        if (this.downloadMp3Btn2) this.downloadMp3Btn2.style.display = 'none';
        if (this.musicContainer) this.musicContainer.style.display = 'none';
        
        // Determine content type
        const isCarousel = data.type === 'carousel' && data.images && data.images.length > 0;
        const isVideo = data.video && data.video.noWatermark;
        const isAudio = data.audio && data.audio.url;
        
        // Preview
        if (isCarousel) {
            // CAROUSEL / IMAGE
            // Sembunyikan previewContainer (area video/image biasa)
            if (this.previewContainer) this.previewContainer.style.display = 'none';
            // renderCarousel set display=flex pada carouselContainer yang di dalamnya
            // sudah ada downloadImageBtn — TIDAK perlu buat tombol baru
            this.renderCarousel(data.images);
            // Defensive: pastikan downloadImageBtn tidak tersembunyi
            if (this.downloadImageBtn) {
                this.downloadImageBtn.style.display = '';
            } else {
                console.warn('downloadImageBtn not found');
            }

        } else if (isVideo) {
            // VIDEO — sembunyikan carousel (otomatis menyembunyikan downloadImageBtn juga)
            if (this.carouselContainer) this.carouselContainer.style.display = 'none';
            if (this.previewContainer) this.previewContainer.style.display = '';
            if (this.previewImage) this.previewImage.style.display = 'none';
            if (this.previewVideo) {
                this.previewVideo.style.display = 'block';
                this.previewVideo.src = data.video.noWatermark;
                this.previewVideo.poster = data.thumbnail || '';
            }
            if (this.playOverlay) this.playOverlay.style.display = 'none';
            // Tampilkan tombol video — MP4 SELALU tampil untuk hasil video
            if (this.downloadMp4Btn) this.downloadMp4Btn.style.display = 'inline-flex';
            if (data.video.hd && this.downloadHdBtn) {
                this.downloadHdBtn.style.display = 'inline-flex';
            }
            // Video TikTok juga punya audio/musik → tampilkan tombol MP3 di sampingnya
            if (data.audio && data.audio.url) {
                if (this.downloadMp3Btn2) this.downloadMp3Btn2.style.display = 'inline-flex';
                if (this.downloadMp3Btn) this.downloadMp3Btn.dataset.url = data.audio.url || '';
            }
            
        } else if (isAudio) {
            // MUSIC — sembunyikan carousel
            if (this.carouselContainer) this.carouselContainer.style.display = 'none';
            if (this.previewContainer) this.previewContainer.style.display = '';
            if (this.previewImage) {
                this.previewImage.style.display = 'block';
                this.previewImage.src = data.thumbnail || 'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="400" height="400"><rect width="400" height="400" fill="rgba(255,255,255,0.05)"/><text x="200" y="200" text-anchor="middle" dy=".3em" fill="rgba(255,255,255,0.2)" font-size="60">🎵</text></svg>';
            }
            if (this.previewVideo) this.previewVideo.style.display = 'none';
            if (this.playOverlay) this.playOverlay.style.display = 'none';
            
            // Tampilkan tombol music
            if (this.downloadMp3Btn2) this.downloadMp3Btn2.style.display = 'inline-flex';
            if (this.musicContainer) this.musicContainer.style.display = 'block';
            if (this.musicTitle) this.musicTitle.textContent = data.audio.title || 'Unknown Track';
            if (this.musicAuthor) this.musicAuthor.textContent = data.audio.author || 'Unknown';
            if (this.downloadMp3Btn) this.downloadMp3Btn.dataset.url = data.audio.url || '';
            
        } else {
            // FALLBACK — sembunyikan carousel
            if (this.carouselContainer) this.carouselContainer.style.display = 'none';
            if (this.previewContainer) this.previewContainer.style.display = '';
            if (this.previewImage) {
                this.previewImage.style.display = 'block';
                this.previewImage.src = data.thumbnail || '';
            }
            if (this.previewVideo) this.previewVideo.style.display = 'none';
            if (this.playOverlay) this.playOverlay.style.display = 'none';
        }
        
        // Info - selalu tampil
        if (this.resultTitle) this.resultTitle.textContent = data.title || 'No Title';
        if (this.resultDuration) this.resultDuration.textContent = this.formatDuration(data.duration || 0);
        if (this.resultDate) this.resultDate.textContent = this.formatDate(data.uploadTime);
        if (this.resultRegion) this.resultRegion.textContent = data.author?.region || 'Global';
        if (this.resultViews) this.resultViews.textContent = this.formatNumber(data.stats?.views || 0);
        if (this.resultLikes) this.resultLikes.textContent = this.formatNumber(data.stats?.likes || 0);
        if (this.resultComments) this.resultComments.textContent = this.formatNumber(data.stats?.comments || 0);
        if (this.resultShares) this.resultShares.textContent = this.formatNumber(data.stats?.shares || 0);
        
        // Author
        if (this.resultAvatar) {
            this.resultAvatar.src = data.author?.avatar || '';
            this.resultAvatar.alt = data.author?.name || 'Author';
        }
        if (this.resultAuthorName) this.resultAuthorName.textContent = data.author?.name || 'Unknown';
        if (this.resultAuthorUsername) this.resultAuthorUsername.textContent = data.author?.username || 'unknown';
        
        // Scroll to result
        if (this.resultSection) {
            this.resultSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }
    
    // ============================================================
    // CAROUSEL
    // ============================================================
    
    renderCarousel(images) {
        this.carouselImages = images;
        this.carouselIndex = 0;
        // Set URL gambar pertama agar downloadImageBtn langsung bisa dipakai
        this.currentImageUrl = (images && images.length > 0) ? images[0] : '';

        // Tampilkan carouselContainer sebagai UI galeri
        if (this.carouselContainer) this.carouselContainer.style.display = 'flex';

        // Render slides
        if (this.carouselSlides) {
            this.carouselSlides.innerHTML = images.map((img, i) => `
                <div class="slide-wrapper">
                    <img src="${img}" alt="Image ${i + 1}" loading="${i === 0 ? 'eager' : 'lazy'}"
                         onerror="this.parentElement.innerHTML='<div style=\\'display:flex;align-items:center;justify-content:center;height:100%;color:rgba(255,255,255,0.2);font-size:40px;\\'>📷</div>'">
                </div>
            `).join('');
        }

        // Render dots (sembunyikan jika hanya 1 gambar)
        if (this.carouselDots) {
            if (images.length <= 1) {
                this.carouselDots.style.display = 'none';
            } else {
                this.carouselDots.style.display = 'flex';
                this.carouselDots.innerHTML = images.map((_, i) => `
                    <span class="${i === 0 ? 'active' : ''}" data-index="${i}"></span>
                `).join('');

                this.carouselDots.querySelectorAll('span').forEach(dot => {
                    dot.addEventListener('click', () => {
                        this.carouselGoTo(parseInt(dot.dataset.index));
                    });
                });
            }
        }

        this.updateCarousel();
        this.initCarouselSwipe();
    }

    carouselGoTo(index) {
        if (index >= 0 && index < this.carouselImages.length) {
            this.carouselIndex = index;
            this.updateCarousel();
        }
    }

    carouselPrevImage() {
        if (this.carouselIndex > 0) {
            this.carouselIndex--;
            this.updateCarousel();
        }
    }

    carouselNextImage() {
        if (this.carouselIndex < this.carouselImages.length - 1) {
            this.carouselIndex++;
            this.updateCarousel();
        }
    }
    
    updateCarousel() {
        const total = this.carouselImages.length;

        if (this.carouselSlides) {
            this.carouselSlides.style.transform = `translateX(-${this.carouselIndex * 100}%)`;
        }

        if (this.carouselCounter) {
            this.carouselCounter.textContent = `${this.carouselIndex + 1} / ${total}`;
        }

        // Update currentImageUrl — downloadImageBtn listener membaca ini saat diklik
        this.currentImageUrl = (this.carouselImages && this.carouselImages[this.carouselIndex])
            ? this.carouselImages[this.carouselIndex]
            : '';

        // Update dots
        if (this.carouselDots) {
            this.carouselDots.querySelectorAll('span').forEach((dot, i) => {
                dot.classList.toggle('active', i === this.carouselIndex);
            });
        }

        // Update opacity tombol prev/next di ujung slide
        if (this.carouselPrev) {
            this.carouselPrev.style.opacity = this.carouselIndex === 0 ? '0.3' : '1';
        }
        if (this.carouselNext) {
            this.carouselNext.style.opacity = this.carouselIndex === total - 1 ? '0.3' : '1';
        }
    }
    
    // ============================================================
    // CAROUSEL TOUCH SWIPE
    // ============================================================

    initCarouselSwipe() {
        const slider = this.carouselSlides;
        if (!slider) return;

        let startX = 0;
        let isDragging = false;

        slider.addEventListener('touchstart', (e) => {
            startX = e.touches[0].clientX;
            isDragging = true;
        }, { passive: true });

        slider.addEventListener('touchend', (e) => {
            if (!isDragging) return;
            const diff = startX - e.changedTouches[0].clientX;
            if (Math.abs(diff) > 40) {
                if (diff > 0) this.carouselNextImage();
                else this.carouselPrevImage();
            }
            isDragging = false;
        }, { passive: true });
    }

    // ============================================================
    // DOWNLOAD FILE — satu helper untuk semua jenis file
    // Alur (SATU-SATUNYA jalur, tidak ada fallback ke URL TikTok langsung):
    //   fetch(/api/proxy?url=...) -> Blob -> URL.createObjectURL()
    //   -> <a download> -> a.click() -> URL.revokeObjectURL()
    // Tidak pernah pakai window.location / window.open / redirect,
    // dan tidak pernah fetch langsung ke CDN TikTok dari browser.
    // ============================================================

    async downloadFile(url, filename) {
        if (!url) {
            this.showToast('❌ Link download tidak tersedia', 'error');
            return;
        }

        this.showToast('📥 Menyiapkan unduhan...', 'info');

        const proxyUrl = this.api.getProxyDownloadUrl(url, filename);

        let blob;
        try {
            const res = await fetch(proxyUrl, { method: 'GET' });
            if (!res.ok) {
                let message = `Server download error (${res.status})`;
                try {
                    const errJson = await res.json();
                    message = errJson.error || message;
                } catch {
                    // response bukan JSON, pakai pesan default
                }
                throw new Error(message);
            }
            blob = await res.blob();
            if (!blob || blob.size === 0) {
                throw new Error('File kosong diterima dari server');
            }
        } catch (err) {
            console.error('Download via proxy gagal:', err.message);
            this.showToast(`❌ Gagal mengunduh file: ${err.message}`, 'error');
            return;
        }

        // ── Blob berhasil didapat → trigger download langsung via object URL
        const objectUrl = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = objectUrl;
        a.download = filename;
        a.style.display = 'none';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(() => URL.revokeObjectURL(objectUrl), 2000);

        this.showToast('✅ File berhasil diunduh', 'success');
    }

    // ============================================================
    // DOWNLOAD VIDEO
    // ============================================================

    async downloadVideo(type) {
        if (!this.currentResult) return;
        const data = this.currentResult.data;
        let url = '';
        let filename = '';

        const user = data.author?.username || 'tiktok';
        switch (type) {
            case 'hd':
                url = data.video?.hd || data.video?.noWatermark || '';
                filename = `mtd-video.mp4`;
                break;
            default: // 'mp4'
                url = data.video?.noWatermark || '';
                filename = `mtd-video.mp4`;
        }

        if (!url) {
            this.showToast('❌ Link video tidak tersedia', 'error');
            return;
        }

        await this.downloadFile(url, filename);
    }

    // ============================================================
    // DOWNLOAD AUDIO
    // ============================================================

    async downloadAudio() {
        if (!this.currentResult) return;
        const data = this.currentResult.data;
        const url = data.audio?.url || '';
        const filename = `mtd-audio.mp3`;

        if (!url) {
            this.showToast('❌ Link audio tidak tersedia', 'error');
            return;
        }

        await this.downloadFile(url, filename);
    }
    
    // ============================================================
    // COPY FUNCTIONS
    // ============================================================
    
    copyCaption() {
        if (!this.currentResult) return;
        const data = this.currentResult.data;
        const title = data.title || '';
        const author = data.author?.name || '';
        const username = data.author?.username || '';
        const text = `${title}\n\n— ${author} (@${username}) • TikTok`;
        
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(() => {
                this.showToast('📋 Caption copied!', 'success');
            }).catch(() => {
                this.fallbackCopy(text);
            });
        } else {
            this.fallbackCopy(text);
        }
    }
    
    fallbackCopy(text) {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        textarea.style.pointerEvents = 'none';
        document.body.appendChild(textarea);
        textarea.select();
        try {
            document.execCommand('copy');
            this.showToast('📋 Caption copied!', 'success');
        } catch (err) {
            this.showToast('❌ Failed to copy caption', 'error');
        }
        document.body.removeChild(textarea);
    }
    
    copyLink() {
        if (!this.currentResult) return;
        const url = this.urlInput ? this.urlInput.value : '';
        
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(() => {
                this.showToast('📋 Link copied!', 'success');
            }).catch(() => {
                this.fallbackCopy(url);
            });
        } else {
            this.fallbackCopy(url);
        }
    }
    
    // ============================================================
    // STATS
    // ============================================================
    
    async loadStats() {
        try {
            const stats = await this.api.getStats();
            if (stats.success) {
                const data = stats.data;
                this.animateNumber('statTotal', data.totalDownloads || 1253882);
                this.animateNumber('statVisitors', data.visitorsToday || 4829);
                this.animateNumber('statOnline', data.onlineUsers || 128);
                
                const apiEl = document.getElementById('statApi');
                if (apiEl) {
                    const active = data.activeApis || 3;
                    const total = data.totalApis || 4;
                    apiEl.innerHTML = `${active} <span style="font-size:16px;color:rgba(255,255,255,0.3)">/ ${total}</span>`;
                }
            }
        } catch (error) {
            console.error('Failed to load stats:', error);
            this.loadStatsFallback();
        }
    }
    
    loadStatsFallback() {
        const total = 1253882 + Math.floor(Math.random() * 100);
        const visitors = 4829 + Math.floor(Math.random() * 20);
        const online = 128 + Math.floor(Math.random() * 10);
        const apiActive = 3 + (Math.random() > 0.8 ? 1 : 0);
        
        this.animateNumber('statTotal', total);
        this.animateNumber('statVisitors', visitors);
        this.animateNumber('statOnline', online);
        
        const apiEl = document.getElementById('statApi');
        if (apiEl) {
            apiEl.innerHTML = `${apiActive} <span style="font-size:16px;color:rgba(255,255,255,0.3)">/ 4</span>`;
        }
    }
    
    animateNumber(elementId, target) {
        const el = document.getElementById(elementId);
        if (!el) return;
        
        const current = parseInt(el.textContent.replace(/,/g, '')) || 0;
        const diff = target - current;
        if (diff === 0) {
            el.textContent = this.formatNumber(target);
            return;
        }
        
        const steps = 20;
        const step = diff / steps;
        let count = current;
        let iteration = 0;
        
        const interval = setInterval(() => {
            iteration++;
            count += step;
            if (iteration >= steps) {
                count = target;
                clearInterval(interval);
            }
            el.textContent = this.formatNumber(Math.floor(count));
        }, 30);
    }
    
    // ============================================================
    // STATUS PAGE
    // ============================================================
    
    async loadStatus() {
        const grid = document.getElementById('statusGrid');
        if (!grid) return;
        
        grid.innerHTML = '<div style="text-align:center;padding:40px;color:rgba(255,255,255,0.3)"><i class="fas fa-spinner fa-spin"></i> Loading...</div>';
        
        try {
            const result = await this.api.getStatus();
            
            if (result.success && result.providers) {
                grid.innerHTML = result.providers.map(s => `
                    <div class="status-item">
                        <div>
                            <span class="status-dot ${s.status}"></span>
                            <strong style="margin-left:8px;">${s.name}</strong>
                        </div>
                        <div>
                            <span style="color:${s.status === 'online' ? '#00f2ea' : '#ff0050'};">
                                ${s.status === 'online' ? '🟢 Online' : '🔴 Offline'}
                            </span>
                            <span class="response-time" style="margin-left:12px;">
                                ${s.status === 'online' ? `${s.responseTime || 0} ms` : 'Timeout'}
                            </span>
                        </div>
                    </div>
                `).join('');
            } else {
                grid.innerHTML = '<div style="text-align:center;padding:40px;color:rgba(255,255,255,0.3)">No data available</div>';
            }
        } catch (error) {
            console.error('Failed to load status:', error);
            grid.innerHTML = '<div style="text-align:center;padding:40px;color:rgba(255,255,255,0.3)">❌ Failed to load status</div>';
        }
    }
    
    // ============================================================
    // DASHBOARD
    // ============================================================
    
    async loadDashboard() {
        try {
            const result = await this.api.getStats();
            if (result.success && result.data) {
                const data = result.data;
                
                const dashDownloads = document.getElementById('dashDownloads');
                const dashVisitors = document.getElementById('dashVisitors');
                const dashRequests = document.getElementById('dashRequests');
                const dashResponse = document.getElementById('dashResponse');
                
                if (dashDownloads) dashDownloads.textContent = this.formatNumber(data.totalDownloads || 0);
                if (dashVisitors) dashVisitors.textContent = this.formatNumber(data.visitorsToday || 0);
                if (dashRequests) dashRequests.textContent = this.formatNumber(data.totalDownloads || 0);
                if (dashResponse) dashResponse.textContent = `${Math.floor(200 + Math.random() * 300)} ms`;
                
                // Chart
                const bars = document.getElementById('chartBars');
                const labels = document.getElementById('chartLabels');
                
                if (data.chart && data.chart.data && data.chart.data.length > 0 && bars && labels) {
                    const max = Math.max(...data.chart.data);
                    
                    bars.innerHTML = data.chart.data.map(val => `
                        <div class="bar" style="height: ${max > 0 ? (val / max) * 100 : 0}%;"></div>
                    `).join('');
                    
                    labels.innerHTML = (data.chart.labels || ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab', 'Min']).map(day => `<span>${day}</span>`).join('');
                } else if (bars && labels) {
                    const fallbackData = [3200, 4500, 2800, 5100, 6800, 4200, 3900];
                    const max = Math.max(...fallbackData);
                    
                    bars.innerHTML = fallbackData.map(val => `
                        <div class="bar" style="height: ${(val / max) * 100}%;"></div>
                    `).join('');
                    
                    labels.innerHTML = ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab', 'Min'].map(day => `<span>${day}</span>`).join('');
                }
            }
        } catch (error) {
            console.error('Failed to load dashboard:', error);
            this.loadDashboardFallback();
        }
    }
    
    loadDashboardFallback() {
        const dashDownloads = document.getElementById('dashDownloads');
        const dashVisitors = document.getElementById('dashVisitors');
        const dashRequests = document.getElementById('dashRequests');
        const dashResponse = document.getElementById('dashResponse');
        
        if (dashDownloads) dashDownloads.textContent = this.formatNumber(1253882);
        if (dashVisitors) dashVisitors.textContent = this.formatNumber(4829);
        if (dashRequests) dashRequests.textContent = this.formatNumber(52301);
        if (dashResponse) dashResponse.textContent = '320 ms';
        
        const bars = document.getElementById('chartBars');
        const labels = document.getElementById('chartLabels');
        
        if (bars && labels) {
            const data = [3200, 4500, 2800, 5100, 6800, 4200, 3900];
            const max = Math.max(...data);
            
            bars.innerHTML = data.map(val => `
                <div class="bar" style="height: ${(val / max) * 100}%;"></div>
            `).join('');
            
            labels.innerHTML = ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab', 'Min'].map(day => `<span>${day}</span>`).join('');
        }
    }
    
    // ============================================================
    // NAVIGATION
    // ============================================================
    
    showPage(page) {
        if (this.heroSection) this.heroSection.style.display = 'none';
        if (this.statsSection) this.statsSection.style.display = 'none';
        if (this.resultSection) this.resultSection.classList.remove('active');
        if (this.statusPage) this.statusPage.style.display = 'none';
        if (this.dashboardPage) this.dashboardPage.style.display = 'none';
        
        switch(page) {
            case 'home':
                if (this.heroSection) this.heroSection.style.display = 'flex';
                if (this.statsSection) this.statsSection.style.display = 'block';
                window.scrollTo({ top: 0, behavior: 'smooth' });
                break;
            case 'status':
                if (this.statusPage) this.statusPage.style.display = 'block';
                this.loadStatus();
                if (this.statusInterval) clearInterval(this.statusInterval);
                this.statusInterval = setInterval(() => this.loadStatus(), 30000);
                window.scrollTo({ top: 0, behavior: 'smooth' });
                break;
            case 'dashboard':
                if (this.dashboardPage) this.dashboardPage.style.display = 'block';
                this.loadDashboard();
                window.scrollTo({ top: 0, behavior: 'smooth' });
                break;
            default:
                if (this.heroSection) this.heroSection.style.display = 'flex';
                if (this.statsSection) this.statsSection.style.display = 'block';
        }
    }
    
    // ============================================================
    // TOAST NOTIFICATION
    // ============================================================
    
    showToast(message, type = 'info') {
        const colors = {
            success: '#00f2ea',
            error: '#ff0050',
            warning: '#ffaa00',
            info: '#00b8ff'
        };
        
        const existing = document.querySelector('.toast-notification');
        if (existing) existing.remove();
        
        const toast = document.createElement('div');
        toast.className = 'toast-notification';
        toast.style.cssText = `
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0,0,0,0.9);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid ${colors[type]}40;
            color: #fff;
            padding: 14px 24px;
            border-radius: 12px;
            font-size: 14px;
            z-index: 999;
            max-width: 90%;
            text-align: center;
            box-shadow: 0 8px 40px rgba(0,0,0,0.5);
            animation: slideUp 0.3s ease;
            border-left: 4px solid ${colors[type]};
            font-family: 'Inter', sans-serif;
        `;
        
        toast.textContent = message;
        document.body.appendChild(toast);
        
        setTimeout(() => {
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(-50%) translateY(20px)';
            toast.style.transition = 'all 0.3s ease';
            setTimeout(() => {
                if (toast.parentNode) toast.remove();
            }, 300);
        }, 4000);
    }
    
    // ============================================================
    // UTILITY FUNCTIONS
    // ============================================================
    
    formatNumber(num) {
        if (num === undefined || num === null) return '0';
        if (num >= 1000000000) return (num / 1000000000).toFixed(1) + 'B';
        if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M';
        if (num >= 1000) return (num / 1000).toFixed(1) + 'K';
        return num.toString();
    }
    
    formatDuration(seconds) {
        if (!seconds || seconds === 0) return '0:00';
        const mins = Math.floor(seconds / 60);
        const secs = Math.floor(seconds % 60);
        return `${mins}:${secs.toString().padStart(2, '0')}`;
    }
    
    formatDate(dateStr) {
        if (!dateStr) return '-';
        try {
            const date = new Date(dateStr);
            if (isNaN(date.getTime())) return '-';
            return date.toLocaleDateString('id-ID', {
                day: 'numeric',
                month: 'short',
                year: 'numeric'
            });
        } catch {
            return '-';
        }
    }
}

// ================================================================
// 3. INIT APP
// ================================================================

const style = document.createElement('style');
style.textContent = `
    @keyframes slideUp {
        from { opacity: 0; transform: translateX(-50%) translateY(20px); }
        to { opacity: 1; transform: translateX(-50%) translateY(0); }
    }
`;
document.head.appendChild(style);

document.addEventListener('DOMContentLoaded', () => {
    const app = new App();
    window.app = app;
});

if (typeof module !== 'undefined' && module.exports) {
    module.exports = App;
}
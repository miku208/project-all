<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>MTD - TikTok Downloader No Watermark</title>
    
    <!-- Prevent zoom out -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, minimum-scale=1.0" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    
    <!-- Meta Tags -->
    <meta name="description" content="Download TikTok Video, Foto Carousel, dan MP3 tanpa watermark dengan cepat. Gratis dan tanpa batasan." />
    <meta name="keywords" content="tiktok downloader, download tiktok, download tiktok tanpa watermark, tiktok mp3, carousel downloader" />
    <meta name="author" content="MTD - Miku TikTok Downloader" />
    <meta name="robots" content="index, follow" />
    
    <!-- Open Graph -->
    <meta property="og:title" content="MTD - TikTok Downloader No Watermark" />
    <meta property="og:description" content="Download TikTok Video, Foto Carousel, dan MP3 tanpa watermark dengan cepat. Gratis dan tanpa batasan." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://mikutiktokdl.web.id" />
    <meta property="og:image" content="https://u.pone.rs/igkudzrh.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="MTD - TikTok Downloader" />
    <meta property="og:locale" content="id_ID" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="MTD - TikTok Downloader No Watermark" />
    <meta name="twitter:description" content="Download TikTok Video, Foto Carousel, dan MP3 tanpa watermark dengan cepat." />
    <meta name="twitter:image" content="https://u.pone.rs/igkudzrh.jpg" />
    
    <!-- Theme Color -->
    <meta name="theme-color" content="#000000" />
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "MTD - TikTok Downloader",
        "description": "Download TikTok Video, Foto Carousel, dan MP3 tanpa watermark dengan cepat.",
        "applicationCategory": "Multimedia",
        "operatingSystem": "All",
        "browserRequirements": "Modern browser",
        "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
        }
    }
    </script>
    
    <!-- Favicon -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎵</text></svg>" />
    <link rel="apple-touch-icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎵</text></svg>" />
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    
    <!-- CSS -->
    <link rel="stylesheet" href="style.css" />
</head>
<body>

<!-- ===== NAVBAR ===== -->
<nav class="navbar" id="navbar">
    <div class="container">
        <a href="#" class="logo" id="homeLink">
            <span class="logo-icon"><i class="fas fa-download"></i></span>
            MTD
        </a>
        
        <ul class="nav-links" id="navLinks">
            <li><a href="#" id="homeLink2">Home</a></li>
            <li><a href="#" id="statusLink">API Status</a></li>
            <li><a href="#" id="dashboardLink">Dashboard</a></li>
            <li><a href="https://github.com" target="_blank"><i class="fab fa-github"></i> GitHub</a></li>
            <li>
                <a href="#" class="whatsapp-link" id="whatsappLink">
                    <i class="fab fa-whatsapp"></i> Update
                </a>
            </li>
        </ul>
        
        <button class="hamburger" id="hamburger" aria-label="Menu">
            <i class="fas fa-bars"></i>
        </button>
    </div>
</nav>

<!-- ===== HERO ===== -->
<section class="hero" id="heroSection">
    <div class="hero-content">
        <div class="badge">
            <i class="fas fa-bolt"></i>
            Fast & Free Downloader
        </div>
        
        <h1>
            Download TikTok<br>
            <span class="text-gradient">Tanpa Watermark</span>
        </h1>
        
        <p>
            Download Video, Foto Carousel, Audio MP3 dengan cepat tanpa watermark.
            Gratis dan tanpa batasan.
        </p>
        
        <div class="input-group">
            <input type="url" class="input" id="urlInput" placeholder="Tempel URL TikTok..." />
            <button class="btn btn-primary btn-lg" id="downloadBtn">
                <i class="fas fa-download"></i> Download
            </button>
        </div>
        
        <div class="trust-badges">
            <span><i class="fas fa-check-circle"></i> 1.2M+ Downloads</span>
            <span><i class="fas fa-user-plus"></i> No Registration</span>
            <span><i class="fas fa-bolt"></i> Fast</span>
        </div>
        
        <!-- ===== WHATSAPP CHANNEL BUTTON ===== -->
        <div class="whatsapp-channel">
            <a href="#" class="whatsapp-channel-btn" id="whatsappChannelBtn">
                <i class="fab fa-whatsapp"></i>
                <div class="whatsapp-channel-text">
                    <span class="whatsapp-channel-title">Dapatkan Update</span>
                    <span class="whatsapp-channel-desc">Info fitur terbaru di WhatsApp</span>
                </div>
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>
</section>

<!-- ===== STATS ===== -->
<section class="stats" id="statsSection">
    <div class="container">
        <div class="stats-grid" id="statsGrid">
            <div class="stat-card card">
                <div class="icon"><i class="fas fa-download"></i></div>
                <div class="number" id="statTotal">0</div>
                <div class="label">Total Download</div>
            </div>
            <div class="stat-card card">
                <div class="icon"><i class="fas fa-users"></i></div>
                <div class="number" id="statVisitors">0</div>
                <div class="label">Visitor Hari Ini</div>
            </div>
            <div class="stat-card card">
                <div class="icon"><i class="fas fa-circle"></i></div>
                <div class="number" id="statOnline">0</div>
                <div class="label">Online User</div>
            </div>
            <div class="stat-card card">
                <div class="icon"><i class="fas fa-server"></i></div>
                <div class="number" id="statApi">0 <span style="font-size:16px;color:rgba(255,255,255,0.3)">/ 4</span></div>
                <div class="label">API Aktif</div>
            </div>
        </div>
    </div>
</section>

<!-- ===== RESULT ===== -->
<section class="result-section" id="resultSection">
    <div class="container">
        <div class="result-grid" id="resultGrid">
            <!-- Preview Column -->
            <div id="previewColumn">
                <!-- Preview untuk Video / Audio / Fallback -->
                <div class="preview" id="previewContainer">
                    <div class="skeleton skeleton-image" id="previewSkeleton"></div>
                    <img id="previewImage" style="display:none" alt="Preview" />
                    <video id="previewVideo" style="display:none" controls playsinline></video>
                    <div class="play-overlay" id="playOverlay" style="display:none">
                        <i class="fas fa-play"></i>
                    </div>
                </div>

                <!-- Galeri Carousel (foto) -->
                <div id="carouselContainer" style="display:none">
                    <div class="carousel">
                        <div class="slides" id="carouselSlides"></div>
                        <div class="carousel-controls">
                            <button id="carouselPrev"><i class="fas fa-chevron-left"></i></button>
                            <span class="counter" id="carouselCounter">1 / 1</span>
                            <button id="carouselNext"><i class="fas fa-chevron-right"></i></button>
                        </div>
                    </div>
                    <div class="dots" id="carouselDots"></div>

                    <!-- SATU tombol download, file mengikuti slide aktif -->
                    <div class="image-download-wrapper">
                        <button class="btn btn-primary btn-block" id="downloadImageBtn">
                            <i class="fas fa-download"></i> Download Image
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Info Column -->
            <div class="result-info" id="resultInfo">
                <div class="skeleton skeleton-text w-75" id="titleSkeleton"></div>
                <div class="skeleton skeleton-text w-50" id="metaSkeleton"></div>
                
                <div id="resultContent" style="display:none">
                    <div class="title" id="resultTitle"></div>
                    
                    <div class="meta" id="resultMeta">
                        <span><i class="far fa-clock"></i> <span id="resultDuration">0:00</span></span>
                        <span><i class="far fa-calendar"></i> <span id="resultDate">-</span></span>
                        <span><i class="fas fa-map-marker-alt"></i> <span id="resultRegion">-</span></span>
                    </div>
                    
                    <div class="meta">
                        <span><i class="far fa-eye"></i> <span id="resultViews">0</span></span>
                        <span><i class="far fa-heart"></i> <span id="resultLikes">0</span></span>
                        <span><i class="far fa-comment"></i> <span id="resultComments">0</span></span>
                        <span><i class="fas fa-share"></i> <span id="resultShares">0</span></span>
                    </div>
                    
                    <div class="author">
                        <img id="resultAvatar" src="" alt="Author" />
                        <div>
                            <div class="name" id="resultAuthorName">-</div>
                            <div class="username">@<span id="resultAuthorUsername">-</span></div>
                        </div>
                    </div>
                    
                    <!-- Music -->
                    <div id="musicContainer" style="display:none">
                        <div class="music-card">
                            <div class="info">
                                <div class="title" id="musicTitle">-</div>
                                <div class="author" id="musicAuthor">-</div>
                            </div>
                            <button class="btn btn-secondary btn-sm" id="downloadMp3Btn">
                                <i class="fas fa-music"></i> MP3
                            </button>
                        </div>
                    </div>
                    
                    <!-- Actions -->
                    <div class="result-actions" id="resultActions">
                        <!-- Video buttons -->
                        <button class="btn btn-primary" id="downloadMp4Btn" style="display:none;">
                            <i class="fas fa-video"></i> MP4
                        </button>
                        <button class="btn btn-secondary" id="downloadHdBtn" style="display:none;">
                            <i class="fas fa-hdmi"></i> HD
                        </button>
                        
                        <!-- Music button -->
                        <button class="btn btn-primary" id="downloadMp3Btn2" style="display:none;">
                            <i class="fas fa-music"></i> Download MP3
                        </button>
                        
                        <!-- Common buttons -->
                        <button class="btn btn-secondary" id="copyCaptionBtn">
                            <i class="fas fa-copy"></i> Caption
                        </button>
                        <button class="btn btn-secondary" id="copyLinkBtn">
                            <i class="fas fa-link"></i> Link
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== STATUS PAGE ===== -->
<section class="stats" id="statusPage" style="display:none; padding-top:100px;">
    <div class="container">
        <h2 style="font-size:28px; font-weight:700; margin-bottom:8px;">API Status</h2>
        <p style="color:rgba(255,255,255,0.4); margin-bottom:24px;">Status real-time semua provider downloader</p>
        
        <div class="status-grid" id="statusGrid">
            <!-- Will be populated by JS -->
        </div>
        
        <div style="text-align:center; margin-top:24px; font-size:13px; color:rgba(255,255,255,0.3);">
            <i class="fas fa-sync-alt"></i> Auto refresh setiap 30 detik
        </div>
    </div>
</section>

<!-- ===== DASHBOARD ===== -->
<section class="stats" id="dashboardPage" style="display:none; padding-top:100px;">
    <div class="container">
        <h2 style="font-size:28px; font-weight:700; margin-bottom:8px;">Dashboard</h2>
        <p style="color:rgba(255,255,255,0.4); margin-bottom:24px;">Statistik download dan performa</p>
        
        <div class="dashboard-grid" id="dashboardStats">
            <div class="card">
                <div style="font-size:13px; color:rgba(255,255,255,0.4);">Downloads (7 hari)</div>
                <div style="font-size:28px; font-weight:700;" id="dashDownloads">0</div>
            </div>
            <div class="card">
                <div style="font-size:13px; color:rgba(255,255,255,0.4);">Visitors (30 hari)</div>
                <div style="font-size:28px; font-weight:700;" id="dashVisitors">0</div>
            </div>
            <div class="card">
                <div style="font-size:13px; color:rgba(255,255,255,0.4);">API Requests</div>
                <div style="font-size:28px; font-weight:700;" id="dashRequests">0</div>
            </div>
            <div class="card">
                <div style="font-size:13px; color:rgba(255,255,255,0.4);">Avg Response</div>
                <div style="font-size:28px; font-weight:700;" id="dashResponse">0 ms</div>
            </div>
        </div>
        
        <div class="dashboard-chart">
            <h4 style="margin-bottom:12px; font-weight:600;">Download per Hari</h4>
            <div class="bar-container" id="chartBars"></div>
            <div class="bar-labels" id="chartLabels"></div>
        </div>
    </div>
</section>

<!-- ===== FOOTER ===== -->
<footer class="footer">
    <div class="container">
        <p>
            &copy; 2026 <strong>MTD</strong> — Miku TikTok Downloader
            <br>
            <a href="#">Privacy</a> · <a href="#">Terms</a> · 
            <a href="https://github.com" target="_blank">GitHub</a>
        </p>
    </div>
</footer>

<!-- ===== JAVASCRIPT ===== -->
<script src="app.js"></script>

</body>
</html>